{
  "name": "youtube2md",
  "version": "1.1.0",
  "description": "Convert a YouTube video to a Markdown summary file",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "bin": {
    "youtube2md": "dist/index.js"
  },
  "type": "module",
  "license": "MIT",
  "author": "sunghyo",
  "keywords": [
    "youtube",
    "markdown",
    "summary",
    "transcript",
    "openai",
    "codex",
    "gpt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunghyo/youtube2md.git"
  },
  "homepage": "https://github.com/sunghyo/youtube2md#readme",
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run typecheck && tsx --test src/__tests__/*.test.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "@distube/ytdl-core": "4.16.12",
    "commander": "12.1.0",
    "dotenv": "16.6.1",
    "openai": "6.46.0",
    "tiktoken": "1.0.22",
    "youtube-transcript": "1.3.1"
  },
  "peerDependencies": {
    "@openai/codex-sdk": "^0.144.1"
  },
  "peerDependenciesMeta": {
    "@openai/codex-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@openai/codex-sdk": "0.144.1",
    "@types/node": "^22.0.0",
    "tsx": "4.23.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
