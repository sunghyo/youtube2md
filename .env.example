# Required: Your OpenAI API key
OPENAI_API_KEY=sk-proj-...your-key-here

# Optional: Override the GPT model (default: gpt-5-mini)
# OPENAI_MODEL=gpt-5-mini

# Optional: Path to an EditThisCookie JSON export for youtube.com
# YOUTUBE_COOKIES_PATH=./cookies.youtube.json

# Optional: Raw Cookie header string for youtube.com requests
# YOUTUBE_COOKIE_HEADER=VISITOR_INFO1_LIVE=...; __Secure-1PSIDTS=...
