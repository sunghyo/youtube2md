# Optional: OpenAI API provider and Whisper STT
# (Codex requires the optional @openai/codex-sdk peer and a ChatGPT login.)
# OPENAI_API_KEY=sk-proj-...your-key-here

# Optional: Override the GPT model (default: gpt-5.6-luna)
# OPENAI_MODEL=gpt-5.6-luna

# Optional: Path to an EditThisCookie JSON export for youtube.com
# YOUTUBE_COOKIES_PATH=./cookies.youtube.json

# Optional: Raw Cookie header string for youtube.com requests
# YOUTUBE_COOKIE_HEADER=VISITOR_INFO1_LIVE=...; __Secure-1PSIDTS=...
